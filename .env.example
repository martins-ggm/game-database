APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres não é opcional: os repositórios buscam com ILIKE, que não existe em
# SQLite nem em MySQL. Trocar de driver quebra toda busca por nome, em silêncio.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=game_database
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# As capas do IGDB são baixadas por job na fila "igdb". Sem um worker atendendo
# essa fila os jobs se acumulam e a capa continua vindo do CDN — funciona, mas a
# cópia local nunca se forma. Em desenvolvimento, `composer dev` já cuida disso.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------- IGDB
# Credenciais de uma aplicação registrada no Twitch Developer Console
# (https://dev.twitch.tv/console/apps). São elas que o IgdbClient troca por um
# token OAuth2 client_credentials, guardado em cache por cerca de 60 dias.
# Sem as duas, `php artisan igdb:sincronizar` falha na primeira requisição.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ------------------------------------------------------------------ Imagens
# IMAGENS_DISK escolhe o disco que o ImagemService usa para ler e gravar. É o
# único lugar que decide isso — helper, views e Resources passam por ele, então
# migrar de storage é trocar esta linha.
#   public  -> storage/app/public, o padrão do Laravel
#   imagens -> disco dedicado, com a raiz em IMAGENS_ROOT
IMAGENS_DISK=public

# Só vale para IMAGENS_DISK=imagens. É a pasta PAI de imagens/, e pode estar em
# outra partição ou outro volume. Use barra normal: o parser de .env trata a
# barra invertida como escape.
# Depois de preencher, rode `php artisan storage:link` para publicar o caminho.
IMAGENS_ROOT=
